{
  "name": "@ssmckinney/ckeditor5-table",
  "version": "48.3.0",
  "description": "Table feature for CKEditor 5.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "CKSource (http://cksource.com/)",
  "homepage": "https://ckeditor.com/ckeditor-5",
  "bugs": "https://github.com/ssmckinney/ckeditor5/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssmckinney/ckeditor5.git",
    "directory": "packages/ckeditor5-table"
  },
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "@ssmckinney/ckeditor5-feature",
    "@ssmckinney/ckeditor5-plugin"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./src/*",
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./dist/*": "./dist/*",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "es-toolkit": "1.45.1",
    "@ssmckinney/ckeditor5-clipboard": "workspace:*",
    "@ssmckinney/ckeditor5-engine": "workspace:*",
    "@ssmckinney/ckeditor5-typing": "workspace:*",
    "@ssmckinney/ckeditor5-widget": "workspace:*",
    "@ssmckinney/ckeditor5-icons": "workspace:*",
    "@ssmckinney/ckeditor5-utils": "workspace:*",
    "@ssmckinney/ckeditor5-core": "workspace:*",
    "@ssmckinney/ckeditor5-ui": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "json-diff-ts": "^4.10.4",
    "vitest": "^4.1.8",
    "@ssmckinney/ckeditor5-editor-multi-root": "workspace:*",
    "@ssmckinney/ckeditor5-horizontal-line": "workspace:*",
    "@ssmckinney/ckeditor5-editor-classic": "workspace:*",
    "@ssmckinney/ckeditor5-source-editing": "workspace:*",
    "@ssmckinney/ckeditor5-basic-styles": "workspace:*",
    "@ssmckinney/ckeditor5-html-support": "workspace:*",
    "@ssmckinney/ckeditor5-block-quote": "workspace:*",
    "@ssmckinney/ckeditor5-media-embed": "workspace:*",
    "@ssmckinney/ckeditor5-autoformat": "workspace:*",
    "@ssmckinney/ckeditor5-essentials": "workspace:*",
    "@ssmckinney/ckeditor5-alignment": "workspace:*",
    "@ssmckinney/ckeditor5-highlight": "workspace:*",
    "@ssmckinney/ckeditor5-paragraph": "workspace:*",
    "@ssmckinney/ckeditor5-autosave": "workspace:*",
    "@ssmckinney/ckeditor5-heading": "workspace:*",
    "@ssmckinney/ckeditor5-indent": "workspace:*",
    "@ssmckinney/ckeditor5-image": "workspace:*",
    "@ssmckinney/ckeditor5-link": "workspace:*",
    "@ssmckinney/ckeditor5-list": "workspace:*",
    "@ssmckinney/ckeditor5-undo": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/nim/build-package.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless=false",
    "test:debug": "vitest --browser.headless=false",
    "coverage": "pnpm run test --coverage"
  },
  "files": [
    "dist",
    "@ssmckinney/ckeditor5-metadata.json",
    "CHANGELOG.md"
  ]
}
